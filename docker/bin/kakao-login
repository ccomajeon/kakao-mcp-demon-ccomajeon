#!/bin/sh
# Link a KakaoTalk account: registers this container as a device after phone approval.
# The password goes to the registration process on standard input only: never in an argument or an
# environment variable (both are readable through /proc), and never written to disk.
set -eu
umask 077
mkdir -p "$HOME" "$KAKAO_DATA_DIR"
cd /data

if [ ! -t 0 ]; then
  echo '[kakao-login] 터미널에서 실행하세요: docker compose -f docker/compose.yaml exec kakao-mcp kakao-login' >&2
  exit 1
fi

printf '카카오 계정 (이메일 또는 전화번호): '
read -r email
trap 'stty echo 2>/dev/null' EXIT INT TERM
stty -echo
printf '비밀번호 (화면에 표시되지 않음): '
# IFS= keeps leading and trailing spaces, which can be part of a password.
IFS= read -r password
stty echo
echo

if [ -z "$email" ] || [ -z "$password" ]; then
  echo '[kakao-login] 계정과 비밀번호를 모두 입력하세요.' >&2
  exit 1
fi

status=0
# printf is a shell builtin, so the password never appears in a process argument list.
printf '%s\n' "$password" | KAKAO_EMAIL="$email" \
  node --experimental-strip-types /app/apps/mcp/src/register.ts --password-stdin || status=$?
unset password
if [ "$status" -eq 0 ]; then
  echo '[kakao-login] 연결했습니다. 이제 데몬을 시작하세요: docker compose -f docker/compose.yaml restart kakao-mcp'
fi
exit "$status"
