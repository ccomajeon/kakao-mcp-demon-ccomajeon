# Allowlist: only what the image needs is sent to the Docker build.
*
!package.json
!package-lock.json
!apps
!packages
!docker/bin

# Never send these, even from inside the folders allowed above.
**/node_modules
**/dist
**/*.tsbuildinfo
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.log
**/*.pcap
**/*.pcapng
**/*.har
**/secrets
**/.kakao
**/.kakao-mcp
**/vault
**/downloads
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/messages.jsonl*
**/frames.jsonl*
**/friends.json*
**/known-chats.json*
**/credentials.json*
**/approvers.json*
**/approver-enroll.json*
**/auth-relogin.json*
**/install-state.json*
**/.DS_Store
